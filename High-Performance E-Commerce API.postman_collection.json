{
  "info": {
    "_postman_id": "184d3e07-4ad6-4b14-bccc-d16d17cd6fba",
    "name": "High-Performance E-Commerce API",
    "description": "Postman collection for the Laravel E-Commerce Backend Engine\n\n**How to use:**\n1. Import this file into Postman\n2. Set the `base_url` variable to `http://127.0.0.1:8000`\n3. Run `Register` or `Login` — the token is saved automatically\n4. All other requests use the token automatically via the collection variable `token`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "32336239"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    console.log('Token saved:', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ahmad Test\",\n  \"email\": \"ahmad@test.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
