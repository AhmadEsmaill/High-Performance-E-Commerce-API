        {
          "name": "Place Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "    pm.collectionVariables.set('order_id', res.data.id);",
                  "    console.log('Order ID saved:', res.data.id);",
                  "    console.log('Jobs dispatched: GenerateInvoice, SendNotification, NotifyLowStock');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Please deliver before 6pm\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "NFR#1: Uses DB transaction + lockForUpdate() to prevent race conditions on stock.\nNFR#3: Dispatches 3 async jobs after placing order:\n  - GenerateInvoiceJob\n  - SendOrderNotificationJob\n  - NotifyLowStockJob (per item)\n\nRequires queue worker to be running: php artisan queue:work"
          },
          "response": []
        },
